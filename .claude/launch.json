{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "build/debug/reactx_serve",
      "runtimeArgs": [
        "build/web",
        "--port",
        "8090"
      ],
      "port": 8090
    },
    {
      "name": "app",
      "runtimeExecutable": "build/debug/api_server",
      "runtimeArgs": [
        "build/web/app",
        "--port",
        "8091"
      ],
      "port": 8091
    },
    {
      "name": "pages",
      "runtimeExecutable": "build/debug/reactx_serve",
      "runtimeArgs": [
        "build/pages/site",
        "--base",
        "/ReactX/",
        "--not-found",
        "404.html",
        "--port",
        "8092"
      ],
      "port": 8092
    },
    {
      "name": "site",
      "runtimeExecutable": "build/debug/reactx_serve",
      "runtimeArgs": [
        "build/web/site",
        "--not-found",
        "404.html",
        "--port",
        "8093"
      ],
      "port": 8093
    }
  ]
}
