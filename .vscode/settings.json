{
    // CMake Tools: configure through CMakePresets.json (Ninja, C++20 modules).
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,

    // C++ in the editor through clangd (see .clangd): it reads the flags of the
    // debug build from build/debug/compile_commands.json and understands C++26.
    // The C/C++ extension's IntelliSense doesn't, and flags correct code.
    "C_Cpp.intelliSenseEngine": "disabled",
    "clangd.arguments": ["--query-driver=**/g++*,**/em++", "--header-insertion=never"],

    "files.associations": { "*.cppm": "cpp" }
}
