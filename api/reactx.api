== parse.hpp
namespace rx {
enum class ParseError {
Empty,
NotANumber,
OutOfRange,
Trailing,
};
constexpr std::string_view describe(ParseError error) {
switch (error) {
case ParseError::Empty: return "empty";
case ParseError::NotANumber: return "not a number";
case ParseError::OutOfRange: return "out of range";
case ParseError::Trailing: return "unexpected characters after the number";
}
return "invalid";
}
template <class T>
concept Number = (std::integral<T> && !std::same_as<T, bool>) || std::floating_point<T>;
template <Number T>
constexpr std::expected<T, ParseError> parseNumber(std::string_view text) {
if (text.empty()) return std::unexpected(ParseError::Empty);
T value{};
const char* last = text.data() + text.size();
auto [end, ec] = std::from_chars(text.data(), last, value);
if (ec == std::errc::invalid_argument) return std::unexpected(ParseError::NotANumber);
if (ec == std::errc::result_out_of_range) return std::unexpected(ParseError::OutOfRange);
if (end != last) return std::unexpected(ParseError::Trailing);
return value;
}
inline std::expected<int, std::string> parsePort(std::string_view text) {
auto bad = [text](std::string_view why) {
return std::unexpected("bad port \"" + std::string(text) + "\": " + std::string(why));
};
return parseNumber<int>(text)
.transform_error([&](ParseError e) { return bad(describe(e)).error(); })
.and_then([&](int port) -> std::expected<int, std::string> {
if (port < 0 || port > 65535) return bad("must be 0..65535");
return port;
});
}
}
== path.hpp
namespace rx {
inline std::string urlDecode(std::string_view text, bool plusIsSpace = false) {
std::string out;
out.reserve(text.size());
auto hex = [](char c) -> int {
if (c >= '0' && c <= '9') return c - '0';
if (c >= 'a' && c <= 'f') return c - 'a' + 10;
if (c >= 'A' && c <= 'F') return c - 'A' + 10;
return -1;
};
for (std::size_t i = 0; i < text.size(); ++i) {
char c = text[i];
if (c == '%' && i + 2 < text.size()) {
int hi = hex(text[i + 1]), lo = hex(text[i + 2]);
if (hi >= 0 && lo >= 0) {
out += static_cast<char>(hi * 16 + lo);
i += 2;
continue;
}
}
out += (plusIsSpace && c == '+') ? ' ' : c;
}
return out;
}
inline std::string urlEncode(std::string_view text) {
static constexpr char hex[] = "0123456789ABCDEF";
std::string out;
out.reserve(text.size());
for (char ch : text) {
auto c = static_cast<unsigned char>(ch);
bool unreserved = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' ||
c == '.' || c == '_' || c == '~';
if (unreserved) {
out += ch;
} else {
out += '%';
out += hex[c >> 4];
out += hex[c & 0xF];
}
}
return out;
}
inline bool matchPath(std::string_view pattern, std::string_view path, std::map<std::string, std::string>& params) {
auto next = [](std::string_view& s) {
while (!s.empty() && s.front() == '/') s.remove_prefix(1);
auto slash = s.find('/');
std::string_view seg = s.substr(0, slash);
s = slash == std::string_view::npos ? std::string_view{} : s.substr(slash);
return seg;
};
std::map<std::string, std::string> found;
while (true) {
std::string_view p = next(pattern);
if (p == "*") {
while (!path.empty() && path.front() == '/') path.remove_prefix(1);
found["*"] = urlDecode(path);
params = std::move(found);
return true;
}
std::string_view s = next(path);
if (p.empty() || s.empty()) {
if (p.empty() && s.empty()) {
params = std::move(found);
return true;
}
return false;
}
if (p.front() == ':') found[std::string(p.substr(1))] = urlDecode(s);
else if (p != s) return false;
}
}
inline std::optional<std::string> queryParam(std::string_view query, std::string_view name) {
if (!query.empty() && query.front() == '?') query.remove_prefix(1);
while (!query.empty()) {
auto amp = query.find('&');
std::string_view pair = query.substr(0, amp);
query = amp == std::string_view::npos ? std::string_view{} : query.substr(amp + 1);
auto eq = pair.find('=');
if (urlDecode(pair.substr(0, eq), true) != name) continue;
return eq == std::string_view::npos ? std::string{} : urlDecode(pair.substr(eq + 1), true);
}
return std::nullopt;
}
}
